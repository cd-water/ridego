# PostgreSQL
POSTGRES_USER=ridepostgres
POSTGRES_PASSWORD=ridepostgres
POSTGRES_DB=ridego
POSTGRES_PORT=5432

# 每服务数据库（由 ops/postgres/init 初始化）
IDENTITY_DB=ridego_identity
TRIP_DB=ridego_trip
DISPATCH_DB=ridego_dispatch
LOCATION_DB=ridego_location
BILLING_DB=ridego_billing

# Redis
REDIS_PASSWORD=rideredis
REDIS_PORT=6379

# Kafka（KRaft 单节点，无认证）
# Compose 内服务使用 kafka:9092；宿主机使用 localhost:9094
KAFKA_EXTERNAL_PORT=9094
KAFKA_CLUSTER_ID=ridego-kafka-cluster

# 应用
JWT_SECRET=ridejwt-ridego-local-dev-secret-32bytes

# Prometheus / Grafana（docker compose --profile monitoring）
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=ridegrafana
GRAFANA_ADMIN_PASSWORD=ridegrafana
